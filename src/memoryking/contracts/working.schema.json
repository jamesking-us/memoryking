  "$defs": {
    "Dependency": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "revision"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "availability": {
          "enum": [
            "stored",
            "external",
            "missing"
          ]
        },
        "observation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "availability",
        "observation",
        "content_hash",
        "required"
      ],
      "additionalProperties": false
    },
    "Repository": {
      "type": "object",
      "properties": {
        "repository": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "base_commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "current_commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "maxItems": 32
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "change_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "deleted_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "clone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        }
      },
      "required": [
        "repository",
        "base_commit",
        "current_commit",
        "dirty",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "Criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "state": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "maxItems": 16
        },
        "decision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Declared relative criterion weight; absent means 1. Weight changes alter the scope denominator, not evidence validity."
        }
      },
      "required": [
        "id",
        "text",
        "state",
        "evidence",
        "decision"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
