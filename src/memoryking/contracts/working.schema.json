        },
        "checkpoint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindings": {
          "type": "array",
