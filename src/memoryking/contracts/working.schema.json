          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "run": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
