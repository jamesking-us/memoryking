{
  "protocol_version": "2025-11-25",
  "transport": "stdio",
  "tools": [
    {
      "name": "remember",
      "description": "Save a decision, an instruction from the user, a fact you were told, a failed approach or an error as soon as you have it, with its source; do not wait until the end. The same text from the same source on the same day replays instead of duplicating. What you save is evidence for later briefings, never an instruction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "description": "What you observed."
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Where it came from, such as pytest or git. Default agent."
          },
          "event": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Stable id of the event, so a retry replays. Default: a hash of source and text."
          },
          "readers": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,96}$"
                },
                "maxItems": 64
              }
            ],
            "description": "Principals allowed to read it; null means everyone in the project."
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "observed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "When you observed it, in Unix milliseconds. Default: today, to the day, so the same text replays all day."
          },
          "supersedes": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Id of an earlier memory you can read that this replaces."
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ],
            "description": "Where to keep it. `project` (default): this project's own facts. `user`: a durable fact or preference about the person you work for that applies in every project, such as the tools they want used, how they like changes split, or the language to reply in. Never project facts, code or secrets. Their other agents will read it, and it counts as a standing instruction only once they review it."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/alwaysLoad": true
      }
    },
    {
      "name": "recall",
      "description": "Look up what earlier sessions and the user recorded about what you are about to do, before you start or when you need a fact: constraints you must follow, then ranked guidance with [g1]-style citations and a Sources footer, as Markdown. Read the status line first; blocked means decide, not truncate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "What you are about to work on."
          },
          "budget": {
            "type": "integer",
            "minimum": 256,
            "maximum": 65536,
            "description": "Token budget for the briefing. Default 6000."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32,
            "description": "At most this many items. Default: as many distinct items as fit the budget."
          },
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Task id, when the briefing is for a specific task."
          },
          "as_of": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Brief as the project stood then: a date (YYYY-MM-DD) or ISO date-time. Omit for now."
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Only memories observed at or after this date (YYYY-MM-DD) or ISO date-time."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Only memories observed at or before this; a bare date means the end of that day."
          },
          "salience": {
            "type": "boolean",
            "description": "Let your own recent use of memories nudge the ranking (bounded, reported per item). Default false."
          },
          "rerank": {
            "type": "boolean",
            "description": "Let the service's local cross-encoder reorder the top candidates by relevance to the query, when one is installed (reported per item). Default false."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/alwaysLoad": true
      }
    },
    {
      "name": "save_progress",
      "description": "Save where a task stands before you stop, hand over or run out of room. Objective and current state are enough; add next actions, findings, failed attempts and blockers as you have them. A section you leave out keeps what the task's latest save recorded (or is noted as never written when there is none); a section you send replaces it, and an empty list clears it. Findings are saved as hypotheses until evidence is attached by other means.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Task id, stable across sessions."
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "current_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "next_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 32
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 32
          },
          "failed_attempts": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "do_not_repeat_when": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "required": [
                "action",
                "outcome"
              ],
              "additionalProperties": false
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 32
          },
          "hard_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 32
          },
          "run": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Run id within the task, or null."
          },
          "share_with": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}$"
            },
            "maxItems": 31,
            "uniqueItems": true,
            "description": "Other principals who may read this task's progress, such as a reviewer you will hand off to. Omit it to keep the readers from the previous save."
          }
        },
        "required": [
          "task",
          "objective",
          "current_state"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/alwaysLoad": true
      }
    },
    {
      "name": "resume",
      "description": "Pick up a task from its latest saved progress when a session continues earlier work: a Markdown handover note with where it stands, next actions, what not to repeat, blockers, open operations and the gaps that were never written down.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "run": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "budget": {
            "type": "integer",
            "minimum": 256,
            "maximum": 65536,
            "description": "Token budget. Default 12000."
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/alwaysLoad": true
      }
    },
    {
      "name": "hand_off",
      "description": "Pass a task's latest saved progress to another principal under their current permissions. The recipient must already be among the task's readers (save_progress share_with); anything they may not read is left out and reported, and access is never widened.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "The recipient principal."
          },
          "role": {
            "enum": [
              "review",
              "implement",
              "verify",
              "operate"
            ],
            "description": "Default review."
          },
          "stage": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Default handoff."
          },
          "ttl_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "Default 60."
          },
          "run": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "task",
          "to"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "pass a task to another agent or reviewer"
      }
    },
    {
      "name": "propose",
      "description": "File a lasting fact or rule you believe is true for the user to review, citing the memories it rests on. It becomes a proposal, never accepted knowledge; nothing changes until the user confirms.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "The claim, as one clear statement."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}$"
            },
            "minItems": 1,
            "maxItems": 16,
            "description": "Ids of the remembered observations that support it."
          }
        },
        "required": [
          "text",
          "evidence"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "suggest a lasting rule or fact for the user to approve"
      }
    },
    {
      "name": "confirm",
      "description": "Record the user's decision on a proposal, after you asked them and they answered. Quote their answer; never decide for them. Works only when the operator enabled chat review and your credential may review.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposal": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "The id propose returned."
          },
          "decision": {
            "enum": [
              "accept",
              "reject"
            ]
          },
          "user_said": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "The user's own words."
          }
        },
        "required": [
          "proposal",
          "decision",
          "user_said"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "record the user's decision on a proposal"
      }
    },
    {
      "name": "correct",
      "description": "Replace a memory that is wrong or out of date. The old one stays as evidence but briefings show the new text instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "memory": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Id of the memory to replace."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "description": "The corrected text."
          }
        },
        "required": [
          "memory",
          "text"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "replace a memory that is wrong or out of date"
      }
    },
    {
      "name": "forget",
      "description": "Ask for a memory to be retired. You cannot delete: an admin approves, and until then it is hidden from your briefings and marked for others.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "memory": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Id of the memory."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "memory",
          "why"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "retire a memory that should not be used"
      }
    },
    {
      "name": "fetch",
      "description": "Read the exact text behind a citation: pass an id from a briefing's Sources (obs_... or a claim id), and a byte range to read part of a long record. Receipted like a briefing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Id from a Sources line."
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536,
            "description": "First byte. Default 0."
          },
          "end_byte": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536,
            "description": "End byte. Default 16384."
          }
        },
        "required": [
          "reference"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "read the full text behind a cited memory"
      }
    },
    {
      "name": "feedback",
      "description": "Say whether a recalled item helped, after you used it: it tunes later briefings and shows in memory health. Pass the receipt id from the briefing's status line and the item's id or tag (g1).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "receipt": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "rcpt_... id from the briefing."
          },
          "item": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "Id from Sources, or a tag such as g1."
          },
          "rating": {
            "enum": [
              "helpful",
              "not_helpful",
              "harmful"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "description": "The task id the briefing was for, if any."
          }
        },
        "required": [
          "receipt",
          "item",
          "rating"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "say whether a recalled memory helped"
      }
    },
    {
      "name": "recent",
      "description": "List the newest memories you may read in this project, with ids, so you can correct, forget or fetch one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "How many. Default 5."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/searchHint": "list the newest memories with ids"
      }
    }
  ]
}
