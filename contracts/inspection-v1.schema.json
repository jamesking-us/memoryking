          "type": "string",
          "pattern": "^([A-Za-z0-9_-]{1,96}|\\*)(?![\\s\\S])"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:*?-]{1,96}(?![\\s\\S])"
        },
        "level": {
          "enum": [
            "trusted",
            "untrusted"
          ]
        },
        "explicit": {
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "source",
        "level"
      ]
    },
