          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "text": {
          "type": "boolean"
        }
      },
      "required": [
        "project"
      ]
    }
