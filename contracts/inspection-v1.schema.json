        "preview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "confirm": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        }
      },
      "required": [
        "project",
        "observation",
        "preview",
        "confirm"
      ]
    },
    "Influence": {
