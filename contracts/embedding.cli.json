{
  "operation": "embedding",
  "command_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://memoryking.invalid/embedding-v1",
    "title": "MemoryKing optional embedding administration and workers v1",
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "configure"
          },
          "args": {
            "$ref": "#/$defs/Configure"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args",
          "key"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "claim"
          },
          "args": {
            "$ref": "#/$defs/Partition"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "complete"
          },
          "args": {
            "$ref": "#/$defs/Complete"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "fail"
          },
          "args": {
            "$ref": "#/$defs/Fail"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "status"
          },
          "args": {
            "$ref": "#/$defs/Partition"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args"
        ]
      }
    ],
    "$defs": {
      "Configure": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "model": {
            "type": "string",
            "enum": [
              "minilm-l6-v2-onnx"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "experimental",
              "disabled"
            ]
          },
          "expected_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "project",
          "model",
          "state",
          "expected_generation"
        ]
      },
      "Partition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "project",
          "fingerprint"
        ]
      },
      "Complete": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "lease": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "vector": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          }
        },
        "required": [
          "project",
          "lease",
          "fingerprint",
          "input_hash",
          "vector",
          "input_tokens",
          "truncated",
          "duration_ms"
        ]
      },
      "Fail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "lease": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "reason": {
            "type": "string",
            "enum": [
              "provider_unavailable",
              "model_invalid",
              "interrupted",
              "provider_failure"
            ]
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          }
        },
        "required": [
          "project",
          "lease",
          "reason",
          "input_tokens",
          "duration_ms"
        ]
      }
    }
  }
}
