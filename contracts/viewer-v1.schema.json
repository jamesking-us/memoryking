{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoryking.invalid/viewer-v1",
  "title": "Delegated observation-read requests v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "viewer_exchange"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "audience": {
              "const": "clankercity-viewer-read-v1"
            },
            "project": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "provider": {
              "const": "github.com"
            },
            "github_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
            },
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "installation_id",
            "audience",
            "project",
            "provider",
            "github_id",
            "session_ref"
          ]
        }
      },
      "required": [
        "version",
        "credential",
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "viewer_read"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lease_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}(?![\\s\\S])"
            },
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "query": {
              "type": "string",
              "maxLength": 256
            },
            "cursor": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "lease_id",
            "session_ref",
            "query",
            "cursor"
          ]
        }
      },
      "required": [
        "version",
        "credential",
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "viewer_close"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lease_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}(?![\\s\\S])"
            },
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "lease_id",
            "session_ref"
          ]
        }
      },
      "required": [
        "version",
        "credential",
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "viewer_registry"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "provider": {
              "const": "github.com"
            },
            "starts": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expires": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "enabled": {
              "type": "boolean"
            },
            "delegator": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "project": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "audience": {
              "const": "clankercity-viewer-read-v1"
            }
          },
          "required": [
            "installation_id",
            "provider",
            "starts",
            "expires",
            "enabled",
            "delegator",
            "project",
            "audience"
          ]
        }
      },
      "required": [
        "version",
        "credential",
        "operation",
        "args"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "const": "viewer_mapping"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "provider": {
              "const": "github.com"
            },
            "starts": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expires": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "enabled": {
              "type": "boolean"
            },
            "github_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
            },
            "subject": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            }
          },
          "required": [
            "installation_id",
            "provider",
            "starts",
            "expires",
            "enabled",
            "github_id",
            "subject"
          ]
        }
      },
      "required": [
        "version",
        "credential",
        "operation",
        "args"
      ]
    }
  ],
  "$defs": {
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 16384
        },
        "source": {
          "type": "string",
          "maxLength": 16384
        },
        "source_event": {
          "type": "string",
          "maxLength": 16384
        },
        "principal": {
          "type": "string",
          "maxLength": 16384
        },
        "project": {
          "type": "string",
          "maxLength": 16384
        },
        "origin": {
          "type": "string",
          "maxLength": 16384
        },
        "classification": {
          "type": "string",
          "maxLength": 16384
        },
        "authority": {
          "const": "observed_episode"
        },
        "assurance": {
          "const": "actor_reported"
        },
        "text": {
          "type": "string",
          "maxLength": 131072
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "source",
        "source_event",
        "principal",
        "project",
        "origin",
        "classification",
        "authority",
        "assurance",
        "text",
        "position",
        "observed_at_ms"
      ]
    },
    "ExchangeResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "lease_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}(?![\\s\\S])"
        },
        "incarnation": {
          "type": "string",
          "maxLength": 16384
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "purge_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expires_ms": {
          "type": "integer",
          "minimum": 0
        },
        "valid_for_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      },
      "required": [
        "version",
        "lease_id",
        "incarnation",
        "policy_epoch",
        "purge_epoch",
        "evaluated_ms",
        "expires_ms",
        "valid_for_ms"
      ]
    },
    "ReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/Item"
              }
            }
          },
          "required": [
            "items"
          ]
        },
        "cursor": {
          "type": "string",
          "maxLength": 4096
        },
        "oversize": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "code": {
                "const": "item_bounds_exceeded"
              }
            },
            "required": [
              "position",
              "code"
            ]
          }
        },
        "access_receipt": {
          "type": "string",
          "maxLength": 16384
        },
        "incarnation": {
          "type": "string",
          "maxLength": 16384
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated_ms": {
          "type": "integer",
          "minimum": 0
        },
        "release_for_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "display_for_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        }
      },
      "required": [
        "version",
        "data",
        "cursor",
        "oversize",
        "access_receipt",
        "incarnation",
        "policy_epoch",
        "evaluated_ms",
        "release_for_ms",
        "display_for_ms"
      ]
    },
    "CloseResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "closed": {
          "const": true
        }
      },
      "required": [
        "version",
        "closed"
      ]
    }
  }
}
