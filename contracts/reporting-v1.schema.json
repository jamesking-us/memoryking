            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "technical_status": {
          "enum": [
            "complete",
            "partial",
            "blocked"
          ]
        },
        "review_status": {
          "enum": [
            "pending",
            "approved",
            "changes_requested"
          ]
        },
        "lifecycle": {
          "enum": [
            "draft",
            "building",
            "built",
            "qa_verified",
            "published",
            "withdrawn",
            "failed"
          ]
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
