        "readers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "maxItems": 256
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        }
      },
      "required": [
        "version",
        "project",
        "report",
        "revision",
        "template",
        "template_version",
        "program",
        "phase",
        "task",
        "title",
        "technical_status",
        "review_status",
        "lifecycle",
        "source_sha256",
        "model_sha256",
        "readme_sha256",
        "evidence_sha256",
        "dependencies",
        "artifacts",
        "readers",
        "classification"
      ]
    },
    "ReportPolicy": {
