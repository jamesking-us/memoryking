        "readme_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "evidence_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportDependency"
          },
          "maxItems": 4096
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportArtifact"
          },
          "maxItems": 3
