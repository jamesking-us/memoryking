          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "report": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "template_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "program": {
          "type": "string",
          "minLength": 1,
