{
  "operation": "processing",
  "command_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Optional processing command v1",
    "$defs": {
      "Proposal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "kind": {
            "const": "knowledge"
          },
          "selector": {
            "type": "object"
          },
          "valid_start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "valid_end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "task": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "run": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "readers": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
                }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observation": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
                },
                "start_byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                }
              },
              "required": [
                "observation",
                "start_byte",
                "end_byte",
                "content_hash"
              ]
            }
          },
          "authority": {
            "type": "null"
          },
          "rule_key": {
            "type": "null"
          },
          "effect": {
            "type": "null"
          },
          "rule_value": {
            "type": "null"
          }
        },
        "required": [
          "text",
          "kind",
          "selector",
          "valid_start",
          "valid_end",
          "task",
          "run",
          "readers",
          "evidence",
          "authority",
          "rule_key",
          "effect",
          "rule_value"
        ]
      },
      "Provenance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "configuration_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "prompt_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "output_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "provider",
          "model",
          "configuration_hash",
          "prompt_revision",
          "input_hash",
          "output_hash"
        ]
      },
      "Extract": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "logical_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "body": {
            "$ref": "#/$defs/Proposal"
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          }
        },
        "required": [
          "project",
          "logical_key",
          "expected_version",
          "body",
          "provenance"
        ]
      },
      "Quote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "observations",
          "text"
        ]
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "critical_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Quote"
            },
            "maxItems": 8
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "attempt": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          }
        },
        "required": [
          "critical_hash",
          "quotes",
          "provenance",
          "attempt"
        ]
      },
      "Compile": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "run": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkpoint": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 256
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "tokenizer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "candidate": {
            "anyOf": [
              {
                "$ref": "#/$defs/Candidate"
              },
              {
                "type": "null"
              }
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
            },
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "project",
          "task",
          "run",
          "checkpoint",
          "bindings",
          "max_output_tokens",
          "tokenizer",
          "sources",
          "candidate",
          "claims"
        ],
        "additionalProperties": false
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "successful_tasks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "project",
          "successful_tasks"
        ]
      }
    },
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "extract"
          },
          "args": {
            "$ref": "#/$defs/Extract"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args",
          "key"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "compile"
          },
          "args": {
            "$ref": "#/$defs/Compile"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "action": {
            "const": "usage"
          },
          "args": {
            "$ref": "#/$defs/Usage"
          }
        },
        "required": [
          "version",
          "incarnation",
          "action",
          "args"
        ]
      }
    ]
  }
}
