    "ViewerAdminCommand": {
      "oneOf": [
        {
          "$ref": "#/$defs/ViewerBind"
        },
        {
          "$ref": "#/$defs/ViewerGrant"
        },
        {
          "$ref": "#/$defs/ViewerRevoke"
        },
        {
          "$ref": "#/$defs/ViewerDisable"
