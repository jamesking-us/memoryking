        "detail_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16384
        },
        "graph_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "graph_edges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 262144
