        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "public_origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "listen_host": {
          "enum": [
            "127.0.0.1",
            "::1"
          ]
        },
        "listen_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "transport": {
          "enum": [
            "isolated_proxy",
            "direct_tls"
          ]
        },
        "github_client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "github_secret_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "tls_cert_file": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "tls_key_file": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "session_idle_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        },
        "session_absolute_seconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 28800
        },
        "login_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300
        },
        "poll_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 60
        },
        "display_lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "limits": {
          "$ref": "#/$defs/ViewerLimits"
        }
      },
      "required": [
        "version",
        "enabled",
        "tenant",
        "public_origin",
        "listen_host",
        "listen_port",
        "transport",
        "github_client_id",
        "github_secret_file",
        "tls_cert_file",
        "tls_key_file",
        "session_idle_seconds",
        "session_absolute_seconds",
        "login_seconds",
        "poll_seconds",
        "display_lifetime_seconds",
        "limits"
