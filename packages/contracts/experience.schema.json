            "kind": {
              "const": "procedure"
            },
            "selector": {
              "type": "object"
            },
            "valid_start": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "valid_end": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "task": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "readers": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
                  }
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "observation": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                  }
                },
                "required": [
                  "observation",
                  "start_byte",
                  "end_byte",
                  "content_hash"
                ]
              }
            },
            "authority": {
              "type": "null"
            },
            "rule_key": {
              "type": "null"
            },
            "effect": {
              "type": "null"
            },
            "rule_value": {
              "type": "null"
            },
            "provenance": {
              "type": "object",
              "maxProperties": 16
            },
            "procedure": {
              "$ref": "#/$defs/Procedure"
            }
          },
          "required": [
            "text",
            "kind",
            "selector",
            "valid_start",
            "valid_end",
            "task",
            "run",
            "readers",
            "evidence",
            "authority",
            "rule_key",
            "effect",
            "rule_value",
            "provenance",
            "procedure"
          ]
        }
      },
      "required": [
        "project",
        "logical_key",
        "expected_version",
        "body"
      ]
