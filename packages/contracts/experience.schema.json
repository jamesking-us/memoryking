    "Procedure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "expected_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "failure_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "known_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "success_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "failure_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "failure_assessment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "dependency_mode": {
          "enum": [
            "independent",
            "required"
