            "selector": {
              "type": "object"
            },
            "valid_start": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "valid_end": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "predecessor",
            "selector",
            "valid_start",
            "valid_end"
          ]
        }
      },
      "required": [
        "project",
        "revision",
        "expected_version",
        "decision",
        "reason",
        "breadth_reviewed"
      ]
