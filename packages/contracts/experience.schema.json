            {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
              }
            }
          ]
        }
      },
      "required": [
        "task",
        "run",
        "result",
        "acceptance_evidence",
        "failures",
        "rework",
        "elapsed_ms",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
