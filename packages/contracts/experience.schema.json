        }
      },
      "required": [
        "prerequisites",
        "steps",
        "verification",
        "expected_artifacts",
        "exceptions",
        "failure_signals",
        "recovery",
        "known_conditions",
        "success_evidence",
        "failure_evidence",
        "failure_assessment",
        "dependency_mode"
