        },
        "action": {
          "const": "capture"
        },
        "args": {
          "$ref": "#/$defs/Capture"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        }
      },
      "required": [
        "version",
        "incarnation",
        "action",
        "args",
        "key"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "incarnation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}(?![\\s\\S])"
        },
        "action": {
