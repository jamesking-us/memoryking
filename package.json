{
  "name": "memoryking-workspace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.8 <11"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node tools/copy-schema.mjs",
    "test": "npm run build && node --test tests/js/*.test.mjs",
    "format": "prettier --write packages tools/*.mjs tests/js package.json tsconfig.json",
    "format:check": "prettier --check packages tools/*.mjs tests/js package.json tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "prettier": "3.9.10",
    "@types/node": "22.20.5"
  }
}
